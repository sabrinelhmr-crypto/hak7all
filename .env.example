# Configuration Hak 7all
APP_ENV=dev
APP_SECRET=CHANGE_ME
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost

# Base de données (MariaDB XAMPP)
DATABASE_URL=\"mysql://root:@127.0.0.1:3306/hak7all?serverVersion=10.4.32-MariaDB&charset=utf8mb4\"

# Mercure
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=\"!ChangeThisMercureHubJWTSecretKey!\"
MERCURE_JWT_ISSUER=https://localhost

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer (dev)
MAILER_DSN=null://null

# Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@hak7all.tn
