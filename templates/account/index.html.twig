{% extends 'base.html.twig' %}

{% block title %}Mon compte — Hak 7all{% endblock %}

{% block body %}
<section class="mx-auto max-w-2xl">
    <header class="mb-4">
        <h1 class="text-2xl font-bold">Mon compte</h1>
        <p class="text-slate-600">Modifier mes informations personnelles.</p>
    </header>

    <div class="card p-4 sm:p-6">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="mb-3">
                {{ form_label(form.fullName) }}
                {{ form_widget(form.fullName, {attr: {class: 'w-full rounded-lg border border-slate-200 px-3 py-3', style: 'min-height:44px;'}}) }}
                {{ form_errors(form.fullName) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone, {attr: {class: 'w-full rounded-lg border border-slate-200 px-3 py-3', style: 'min-height:44px;'}}) }}
                <p class="text-xs text-slate-500 mt-1">{{ form_help(form.phone) }}</p>
                {{ form_errors(form.phone) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.city) }}
                {{ form_widget(form.city, {attr: {class: 'w-full rounded-lg border border-slate-200 px-3 py-3', style: 'min-height:44px;'}}) }}
                {{ form_errors(form.city) }}
            </div>
            {{ form_rest(form) }}
            <button class="btn-primary">Enregistrer</button>
        {{ form_end(form) }}
    </div>

    <div class="mt-4 card p-4 sm:p-6 border-red-200">
        <h2 class="font-semibold text-red-700">Supprimer mon compte</h2>
        <p class="text-sm text-slate-600 mt-1">Cette action supprime vos données personnelles. Elle est irréversible.</p>
        <form method="post" action="{{ path('app_account_delete') }}" class="mt-3" onsubmit="return confirm('Voulez-vous vraiment supprimer votre compte ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
            <button class="btn-ghost text-red-700 border border-red-200">Supprimer mon compte</button>
        </form>
    </div>
</section>
{% endblock %}
